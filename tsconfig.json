{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["ES2020"],
    "strict": true,
    "noEmit": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "skipLibCheck": true,
    "typeRoots": ["./node_modules/@types", "./node_modules/@figma"]
  },
  "include": ["src/**/*.ts", "test/**/*.ts"]
}
